from _typeshed import Incomplete
from dataclasses import dataclass

__all__ = ['VTSDeviceFinder', 'VTSDeviceConfig']

@dataclass
class VTSDeviceConfig:
    name: str
    SN: str
    index: int

class VTSDeviceFinder:
    BRAND_NAME: str
    _cameras: Incomplete
    def __init__(self, SN: str = None) -> None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def indexes(self) -> list[int]: ...
    def count(self) -> int: ...
    def get_device_by_sn(self, sn: str) -> VTSDeviceConfig | None: ...
    def get_sns(self) -> list[str]: ...
    def get_devices(self) -> list[VTSDeviceConfig]: ...

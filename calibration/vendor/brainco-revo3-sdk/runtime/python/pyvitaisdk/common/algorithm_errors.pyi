from .exceptions import VTSError
from typing import Any, Callable, TypeVar

__all__ = ['AlgorithmAdapter', 'adapt_algorithm', 'call_algorithm', 'translate_algorithm_error']

T = TypeVar('T')

def translate_algorithm_error(error: Exception) -> VTSError: ...
def call_algorithm(function: Callable[..., T], *args: Any, **kwargs: Any) -> T: ...

class AlgorithmAdapter:
    def __init__(self, implementation: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...

def adapt_algorithm(implementation: T) -> T: ...

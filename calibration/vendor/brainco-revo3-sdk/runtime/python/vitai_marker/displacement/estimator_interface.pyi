import abc
import numpy as np
from abc import ABC, abstractmethod

class IDisplacementEstimator(ABC, metaclass=abc.ABCMeta):
    @abstractmethod
    def initialize(self, initial_points: np.ndarray): ...
    @abstractmethod
    def set_query_points(self, query_points: np.ndarray): ...
    @abstractmethod
    def get_query_points(self) -> np.ndarray: ...
    @abstractmethod
    def update_displacements(self, current_points: np.ndarray): ...
    @abstractmethod
    def estimate(self, query_points: np.ndarray): ...

from _typeshed import Incomplete
from typing import Any

__all__ = ['InvalidFrameError', 'InvalidFrameTypeError', 'InvalidMarkerCountError', 'InvalidParameterError', 'InvalidTrackingMethodError', 'MarkerError']

class MarkerError(Exception):
    message: Incomplete
    suggestion: Incomplete
    context: Incomplete
    def __init__(self, message: str, suggestion: str | None = None, context: dict[str, Any] | None = None) -> None: ...

class InvalidMarkerCountError(MarkerError, ValueError): ...
class InvalidFrameError(MarkerError, ValueError): ...
class InvalidFrameTypeError(MarkerError, TypeError): ...
class InvalidTrackingMethodError(MarkerError, ValueError): ...
class InvalidParameterError(MarkerError, ValueError): ...

from dataclasses import dataclass

@dataclass
class CameraParams:
    brightness: int = ...
    contrast: int = ...
    hue: int = ...
    saturation: int = ...
    sharpness: int = ...
    gamma: int = ...
    auto_wb: int = ...
    wb_blue: int = ...
    gain: int = ...
    auto_exposure: int = ...
    exposure: int = ...

class CameraParamsSetter:
    @staticmethod
    def set_params(cap, params: CameraParams) -> None: ...

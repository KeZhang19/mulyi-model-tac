from _typeshed import Incomplete
from typing import Any

__all__ = ['ForceError', 'InvalidParameterError', 'ModelInitializationError', 'ModelLoadError', 'ModelNotFoundError']

class ForceError(Exception):
    message: Incomplete
    suggestion: Incomplete
    context: Incomplete
    def __init__(self, message: str, suggestion: str | None = None, context: dict[str, Any] | None = None) -> None: ...

class ModelInitializationError(ForceError, RuntimeError): ...
class ModelLoadError(ForceError, RuntimeError): ...
class ModelNotFoundError(ForceError, FileNotFoundError): ...
class InvalidParameterError(ForceError, ValueError): ...

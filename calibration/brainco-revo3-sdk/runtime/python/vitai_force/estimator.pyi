import numpy as np
from .inference_mlp import MLPForceEstimator
from _typeshed import Incomplete
from pathlib import Path
from typing import Callable, Iterable

__all__ = ['ForceEstimator']

class ForceEstimator:
    _model_path: Incomplete
    _device_id: Incomplete
    _sensor_serial: Incomplete
    _marker_shape: Incomplete
    _model_factory: Incomplete
    _model: MLPForceEstimator | None
    _baseline: np.ndarray | None
    _prediction_bias: Incomplete
    _calibration_coefficients: np.ndarray | None
    _postprocess_enabled: bool
    _kf_r: float
    _kf_q: float
    _kf_fz: float
    _kf_fz_covariance: float
    def __init__(self, model_path: str, device_id: int = 0, sensor_serial: str | None = None, marker_shape: tuple[int, int] = (20, 20), model_factory: Callable[..., MLPForceEstimator] = ...) -> None: ...
    @property
    def model_path(self) -> str: ...
    @property
    def baseline(self) -> np.ndarray | None: ...
    @property
    def prediction_bias(self) -> np.ndarray: ...
    def load(self) -> None: ...
    @staticmethod
    def _load_normalization(path: Path) -> dict | None: ...
    def _load_fz_calibration(self, path: Path) -> None: ...
    @staticmethod
    def sample_marker_xyz(markers: np.ndarray, depth_map: np.ndarray) -> np.ndarray: ...
    @staticmethod
    def apply_baseline_correction(observation: np.ndarray, baseline: np.ndarray | None) -> np.ndarray: ...
    def build_observation(self, origin_markers: np.ndarray, current_markers: np.ndarray, depth_map: np.ndarray, apply_baseline: bool = True) -> np.ndarray: ...
    def set_baseline(self, observations: Iterable[np.ndarray]) -> np.ndarray: ...
    def calibrate_prediction_bias(self, samples: Iterable[np.ndarray]) -> np.ndarray: ...
    def set_postprocess_enabled(self, enabled: bool) -> None: ...
    def estimate(self, origin_markers: np.ndarray, current_markers: np.ndarray, depth_map: np.ndarray) -> np.ndarray: ...
    def estimate_observation(self, observation: np.ndarray) -> np.ndarray: ...
    def _filter_fz(self, value: float) -> float: ...
    def release(self) -> None: ...

from _typeshed import Incomplete
from typing import Any

__all__ = ['DepthError', 'InvalidFrameError', 'InvalidFrameTypeError', 'InvalidParameterError', 'ModelInitializationError', 'ModelLoadError', 'ModelNotFoundError', 'ModelNotInitializedError']

class DepthError(Exception):
    message: Incomplete
    suggestion: Incomplete
    context: Incomplete
    def __init__(self, message: str, suggestion: str | None = None, context: dict[str, Any] | None = None) -> None: ...

class ModelLoadError(DepthError, RuntimeError): ...
class ModelInitializationError(DepthError, RuntimeError): ...
class ModelNotFoundError(DepthError, FileNotFoundError): ...
class ModelNotInitializedError(DepthError, RuntimeError): ...
class InvalidFrameTypeError(DepthError, TypeError): ...
class InvalidFrameError(DepthError, ValueError): ...
class InvalidParameterError(DepthError, ValueError): ...

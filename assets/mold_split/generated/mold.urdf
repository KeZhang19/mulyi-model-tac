<?xml version='1.0' encoding='utf-8'?>
<robot name="two_part_hand_mold">
  <!--Geometry/kinematics asset. CAD axes preserved, meshes in meters. No measured mass/inertia available.-->
  <!--Display colors and joint limits are authoring choices, not source CAD material or machine specifications.-->
  <link name="lower_mold">
    <visual name="lower_mold_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/lower_mold.stl" scale="1 1 1" />
      </geometry>
      <material name="lower_mold_display_only">
        <color rgba="0.65 0.68 0.72 1" />
      </material>
    </visual>
    <collision name="lower_mold_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/lower_mold.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="upper_mold">
    <visual name="upper_mold_visual">
      <origin xyz="-0.000131918961128229 -3.61990628226118e-05 0.00686501506351972" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_mold.stl" scale="1 1 1" />
      </geometry>
      <material name="upper_mold_display_only">
        <color rgba="0.28 0.55 0.82 1" />
      </material>
    </visual>
    <collision name="upper_mold_collision">
      <origin xyz="-0.000131918961128229 -3.61990628226118e-05 0.00686501506351972" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_mold.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <joint name="mold_opening" type="prismatic">
    <parent link="lower_mold" />
    <child link="upper_mold" />
    <origin xyz="0.000131918961128229 3.61990628226118e-05 -0.00686501506351972" rpy="0 0 0" />
    <axis xyz="-0.0192123072704608 -0.00527192991744921 0.99980152730644" />
    <limit lower="0" upper="0.15" effort="100.0" velocity="0.05" />
  </joint>
</robot>
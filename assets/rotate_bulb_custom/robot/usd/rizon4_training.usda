#usda 1.0
(
    defaultPrim = "flexiv_rizon4"
    subLayers = [
        @configuration/rizon4_collision_filters.usda@,
        @rizon4.usd@
    ]
)

over "flexiv_rizon4"
{
    over "root_joint"
    {
        bool physxArticulation:enabledSelfCollisions = true
    }

    over "palm"
    {
        custom int tactile:gridRows = 6
        custom int tactile:gridCols = 6
        custom float tactile:rowDistanceM = 0.008
        custom float tactile:colDistanceM = 0.008
        custom point3f tactile:gridOrigin = (0.005008058, -0.005, 0.01)
        custom normal3f tactile:gridNormal = (0.9659258, 0, 0.25881904)
        custom float tactile:gridPitchDeg = -15
    }

    over "right_index_MCP_Link"
    {
        custom int tactile:gridRows = 4
        custom int tactile:gridCols = 8
        custom float tactile:rowDistanceM = 0.0035
        custom float tactile:colDistanceM = 0.0023571428
        custom point3f tactile:gridOrigin = (0.01213802, 0.00151203, 0.02719285)
        custom normal3f tactile:gridNormal = (1, 0, 0)
    }

    over "right_index_PIP_Link"
    {
        custom int tactile:gridRows = 4
        custom int tactile:gridCols = 8
        custom float tactile:rowDistanceM = 0.0035
        custom float tactile:colDistanceM = 0.0023571428
        custom point3f tactile:gridOrigin = (0.01016522, 0.00056174, 0.01676985)
        custom normal3f tactile:gridNormal = (1, 0, 0)
    }

    over "right_index_DIP_Link"
    {
        custom token tactile:layout = "wrappedSurface"
        custom int tactile:gridRows = 8
        custom int tactile:gridCols = 8
        custom int tactile:taxelCount = 64
    }

    over "right_little_MCP_Link"
    {
        custom int tactile:gridRows = 4
        custom int tactile:gridCols = 8
        custom float tactile:rowDistanceM = 0.0035
        custom float tactile:colDistanceM = 0.0023571428
        custom point3f tactile:gridOrigin = (0.01209902, -0.00151572, 0.02719868)
        custom normal3f tactile:gridNormal = (1, 0, 0)
    }

    over "right_little_PIP_Link"
    {
        custom int tactile:gridRows = 4
        custom int tactile:gridCols = 8
        custom float tactile:rowDistanceM = 0.0035
        custom float tactile:colDistanceM = 0.0023571428
        custom point3f tactile:gridOrigin = (0.01011729, -0.00056416, 0.01677868)

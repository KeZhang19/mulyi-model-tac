+    _, rot_error = compute_pose_error(goal_w, goal_quat,
+        command.object.data.root_pos_w, command.object.data.root_quat_w)
+    return value * (1 - torch.tanh(torch.linalg.vector_norm(rot_error, dim=-1) / rot_std))

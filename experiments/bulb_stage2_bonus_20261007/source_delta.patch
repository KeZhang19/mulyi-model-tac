 class CurriculumChecks(unittest.TestCase):
+    def test_stage_two_bonus_requires_hold_and_pays_once_even_after_reentry(self):
+        env, c = fixture()
+        c.stage_two[:] = True
+        place_inserted(env, c)
+        for _ in range(c.required_hold_steps - 1):
+            c.advance()
+            self.assertFalse(curriculum.stage_two_success_bonus(env).any())
+        c.advance()
+        torch.testing.assert_close(10 * curriculum.stage_two_success_bonus(env) * env.step_dt,
+                                   torch.full((4,), 10.))
+        self.assertFalse(c.final_bonus_credit.any())
+        c.advance()
+        self.assertFalse(curriculum.stage_two_success_bonus(env).any())
+        env.scene["object"].data.root_lin_vel_w[:] = .04
+        c.advance()
+        env.scene["object"].data.root_lin_vel_w.zero_()
+        hold(c)
+        self.assertFalse(curriculum.stage_two_success_bonus(env).any())
+
+    def test_stage_two_bonus_failure_gate_and_reset_rearm(self):
+        env, c = fixture()
+        c.stage_two[:] = True
+        place_inserted(env, c)
+        hold(c)
+        env.termination_manager = NS(terminated=torch.tensor([True, False, False, False]))
+        torch.testing.assert_close(10 * curriculum.stage_two_success_bonus(env) * env.step_dt,
+                                   torch.tensor([0., 10., 10., 10.]))
+        # Timeout is not a physical failure, so it does not suppress promotion.
+        self.assertEqual(curriculum.grasp_screw_time_out(env).tolist(), [False] * 4)
+        c.reset([0, 2])
+        self.assertEqual(c.stage_two_bonus_credit.tolist(), [0., 1., 0., 1.])
+        c.stage_two[:] = True
+        env.termination_manager.terminated.zero_()
+        place_inserted(env, c)
+        hold(c)
+        torch.testing.assert_close(10 * curriculum.stage_two_success_bonus(env) * env.step_dt,
+                                   torch.tensor([10., 0., 10., 0.]))
+
+    def test_stage_two_bonus_is_dt_independent(self):
+        for dt in (1 / 30, 1 / 60, 1 / 120):
+            env, c = fixture()

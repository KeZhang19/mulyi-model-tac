+    def test_both_targets_follow_one_socket_with_12cm_descent(self):
+        env, c = fixture()
+        c._update_metrics()
+        first = c.pose_command_w[:, :3].clone()
+        socket_before = env.scene["socket"].data.root_state_w.clone()
+        mouth = env.scene["socket"].data.root_pos_w + torch.tensor([0, 0, c.cfg.socket_mouth_x_m])
+        torch.testing.assert_close(first, mouth + torch.tensor([0, 0, .15]))
+        place_at_goal(env, c)
+        c.advance()
+        torch.testing.assert_close(c.pose_command_w[:, :3], first - torch.tensor([0, 0, .12]))
+        torch.testing.assert_close(env.scene["socket"].data.root_state_w, socket_before)
+        self.assertFalse(c.metrics["success"].any())
+
+    def test_socket_xy_inherits_ranges_and_robot_yaw(self):
+        torch.manual_seed(42)
+        env, c = fixture(4096)
+        # Keep large environment origins out of this distribution precision check.
+        robot = env.scene["robot"]
+        robot.data.root_pos_w[:] = torch.tensor([.44, -.1, .76])
+        robot.data.root_quat_w[:] = math_utils.quat_from_euler_xyz(torch.zeros(4096), torch.zeros(4096), torch.full((4096,), .7))
+        curriculum.reset_socket_from_target_ranges(env)
+        positions, _ = math_utils.subtract_frame_transforms(robot.data.root_pos_w, robot.data.root_quat_w,
+                                                            env.scene["socket"].data.root_pos_w)
+        for i, limits in enumerate((c.cfg.ranges.pos_x, c.cfg.ranges.pos_y)):
+            self.assertGreaterEqual(positions[:, i].min().item(), limits[0] - 1e-6)
+            self.assertLessEqual(positions[:, i].max().item(), limits[1] + 1e-6)
+            self.assertAlmostEqual(positions[:, i].mean().item(), sum(limits) / 2, delta=.01)
+            self.assertGreater(positions[:, i].max().item() - positions[:, i].min().item(), .98 * (limits[1] - limits[0]))
+
+    def test_socket_reset_uses_table_height_and_zero_velocity(self):
+        env, c = fixture()
+        env.scene["table"].data.root_pos_w[:, 2] += torch.tensor([0., .1, .2, .3])
+        env.scene["socket"].data.root_state_w[:, 7:] = 4
+        curriculum.reset_socket_from_target_ranges(env)
+        socket = env.scene["socket"].data
+        bottom_z = socket.root_pos_w[:, 2] + c.cfg.socket_bottom_x_m
+        torch.testing.assert_close(bottom_z, env.scene["table"].data.root_pos_w[:, 2] + .38)
+        torch.testing.assert_close(socket.root_state_w[:, 7:], torch.zeros(4, 6))
+        torch.testing.assert_close(socket.root_quat_w, socket.default_root_state[:, 3:7])
+

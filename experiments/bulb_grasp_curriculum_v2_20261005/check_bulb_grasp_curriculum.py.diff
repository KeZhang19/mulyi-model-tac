+        import numpy as np
+        stage = Usd.Stage.Open(str(ROOT / "assets/bulb_grasp_teacher/bulb_grasp.usd"))
+        points = np.concatenate([np.asarray(UsdGeom.Mesh(stage.GetPrimAtPath(f"/Bulb/base_link/{name}")).GetPointsAttr().Get())

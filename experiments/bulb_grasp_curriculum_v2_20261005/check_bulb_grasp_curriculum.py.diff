+        env, c = fixture()
+        radius = float(np.linalg.norm(points, axis=1).max())
+        mouth_z = .36246766267473585 + .76 / 2 - c.cfg.socket_bottom_x_m + c.cfg.socket_mouth_x_m
+        # All inherited bulb scales/orientations start above the socket, even at coincident XY.
+        self.assertGreater(.8567860984483967 - radius * 1.2 - mouth_z, .004)
+        # 3 cm is a center target implying partial entry, not proof of collision-free insertion.

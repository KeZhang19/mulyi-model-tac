@@ -0,0 +1,241 @@
+#!/usr/bin/env python3
+"""CPU checks for the optional teacher LSTM, including real recurrent PPO updates.
+
+No Kit, GPU, scene, remote host or existing checkpoint is used.
+"""
+import contextlib
+import copy
+import importlib.util
+import inspect
+import io
+import json
+from pathlib import Path
+import runpy
+import sys
+from types import ModuleType, SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+TASK = ROOT / "source/BrainCo_DexHand/BrainCo_DexHand/tasks/manager_based/dexsuite/config/BulbGraspTeacher"
+sys.path.insert(0, str(ROOT / "runtime/bulb_grasp_teacher"))
+
+import torch
+from tensordict import TensorDict
+from rsl_rl.algorithms import PPO
+from rsl_rl.modules import ActorCritic
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    sys.modules[name] = value
+    spec.loader.exec_module(value)
+    return value
+
+
+package = ModuleType("bulb_lstm_check")
+package.__path__ = [str(TASK)]
+sys.modules[package.__name__] = package
+policy_module = load("bulb_lstm_check.policy", TASK / "policy.py")
+runner_module = load("bulb_lstm_check.teacher_runner", TASK / "teacher_runner.py")
+
+
+def config_node(value):
+    if isinstance(value, list):
+        return [config_node(item) for item in value]
+    if isinstance(value, dict):
+        if "$type" in value:
+            return NS(**{key: config_node(item) for key, item in value["fields"].items()})
+        return {key: config_node(item) for key, item in value.items()}
+    return value
+
+
+def configs():
+    env = config_node(json.loads((TASK / "teacher_snapshot.json").read_text()))
+    values = json.loads((TASK / "agent_snapshot.json").read_text())
+    agent = NS(**{**values, "policy": NS(**values["policy"])})
+    return env, agent
+
+
+def observations(n=8, history=1):
+    return TensorDict({name: torch.randn(n, width * history)
+                       for name, width in {"policy": 39, "proprio": 149, "perception": 192}.items()}, [n])
+
+
+def make_policy(obs=None):
+    env, agent = configs()
+    policy_module.configure_bulb_teacher_lstm(env, agent)
+    kwargs = vars(agent.policy).copy()
+    kwargs.pop("class_name")
+    with contextlib.redirect_stdout(io.StringIO()):
+        policy = policy_module.BulbGraspTeacherLSTM(
+            observations() if obs is None else obs, agent.obs_groups, 28, **kwargs)
+    return policy
+
+
+class LSTMChecks(unittest.TestCase):
+    def setUp(self):
+        torch.manual_seed(17)
+
+    def test_opt_in_config_preserves_other_settings(self):
+        env, agent = configs()
+        before_env, before_agent = copy.deepcopy(env), copy.deepcopy(agent)
+        self.assertEqual([env.observations.policy.history_length,
+                          env.observations.proprio.history_length,
+                          env.observations.perception.history_length], [5, 5, 5])
+        self.assertEqual(agent.policy.class_name, "ActorCritic")
+        policy_module.configure_bulb_teacher_lstm(env, agent)
+        for group in vars(before_env.observations).values():
+            group.history_length = 1
+        self.assertEqual(vars(env), vars(before_env))
+        expected = vars(before_agent.policy) | dict(class_name="BulbGraspTeacherLSTM", rnn_type="lstm",
+                                                   rnn_hidden_dim=256, rnn_num_layers=1)
+        self.assertEqual(vars(agent.policy), expected)
+        self.assertEqual(agent.obs_groups, before_agent.obs_groups)
+        self.assertEqual(agent.algorithm, before_agent.algorithm)
+
+    def test_forward_memory_and_partial_episode_reset(self):
+        policy = make_policy().eval()
+        obs = observations()
+        self.assertEqual(policy.memory_a.rnn.input_size, 380)
+        self.assertEqual(policy.memory_c.rnn.input_size, 380)
+        self.assertEqual(policy.memory_a.rnn.num_layers, 1)
+        self.assertEqual(policy.memory_a.rnn.hidden_size, 256)
+        with torch.inference_mode():
+            first = policy.act_inference(obs)
+            second = policy.act_inference(obs)
+            policy.evaluate(obs)
+            self.assertEqual(first.shape, (8, 28))
+            self.assertFalse(torch.allclose(first, second))
+            states = [[x.clone() for x in state] for state in policy.get_hidden_states()]
+            done = torch.tensor([True, False, False, True, False, False, False, False])
+            policy.reset(done)
+            for state, previous in zip(policy.get_hidden_states(), states):
+                for current, saved in zip(state, previous):
+                    self.assertEqual(torch.count_nonzero(current[:, done]).item(), 0)
+                    torch.testing.assert_close(current[:, ~done], saved[:, ~done])
+            reset_action = policy.act_inference(obs)
+            torch.testing.assert_close(reset_action[done], first[done])
+            policy.reset()
+            torch.testing.assert_close(policy.act_inference(obs), first)
+
+    def test_bootstrap_does_not_advance_critic_memory(self):
+        policy = make_policy()
+        obs = observations()
+        with torch.inference_mode():
+            policy.evaluate(obs)
+            saved = tuple(x.clone() for x in policy.memory_c.hidden_states)
+            value = policy.evaluate(obs, masks="compute_returns")
+            for current, old in zip(policy.memory_c.hidden_states, saved):
+                torch.testing.assert_close(current, old)
+            torch.testing.assert_close(value, policy.evaluate(obs))
+
+    def test_noise_bounds(self):
+        policy = make_policy()
+        with torch.inference_mode():
+            policy.std[:14] = -1
+            policy.std[14:] = 2
+            policy.act(observations())
+            torch.testing.assert_close(policy.action_std[:, :14], torch.full((8, 14), .05))
+            torch.testing.assert_close(policy.action_std[:, 14:], torch.full((8, 14), .5))
+
+    def test_strict_checkpoint_roundtrip_and_mlp_rejection(self):
+        policy = make_policy()
+        obs = observations()
+        policy.update_normalization(obs)
+        buffer = io.BytesIO()
+        torch.save(policy.state_dict(), buffer)
+        buffer.seek(0)
+        restored = make_policy().eval()
+        restored.load_state_dict(torch.load(buffer, weights_only=True), strict=True)
+        policy.eval()
+        with torch.inference_mode():
+            torch.testing.assert_close(policy.act_inference(obs), restored.act_inference(obs))
+        _, agent = configs()
+        kwargs = vars(agent.policy).copy()
+        kwargs.pop("class_name")
+        with contextlib.redirect_stdout(io.StringIO()):
+            mlp = ActorCritic(observations(history=5), agent.obs_groups, 28, **kwargs)
+        with self.assertRaisesRegex(ValueError, "start a fresh run"):
+            restored.load_state_dict(mlp.state_dict())
+        with self.assertRaises(RuntimeError):
+            mlp.load_state_dict(restored.state_dict())
+
+    def test_real_runner_factory_and_two_ppo_updates(self):
+        # Execute the real runner factory and PPO/storage with asynchronous episode ends.
+        # Only the environment observations/rewards/dones are synthetic.
+        _, agent = configs()
+        env_cfg, _ = configs()
+        policy_module.configure_bulb_teacher_lstm(env_cfg, agent)
+        runner = runner_module.OnPolicyRunner.__new__(runner_module.OnPolicyRunner)
+        runner.cfg = vars(agent)
+        runner.policy_cfg = vars(agent.policy)
+        runner.alg_cfg = agent.algorithm.copy()
+        if "share_cnn_encoders" not in inspect.signature(PPO).parameters:
+            self.assertIs(runner.alg_cfg.pop("share_cnn_encoders"), False)
+        runner.env = NS(num_envs=8, num_actions=28)
+        runner.device = "cpu"
+        runner.multi_gpu_cfg = None
+        runner.num_steps_per_env = 32
+        obs = observations()
+        with contextlib.redirect_stdout(io.StringIO()):
+            ppo = runner._construct_algorithm(obs)
+        self.assertIsInstance(ppo.policy, policy_module.BulbGraspTeacherLSTM)
+        before = {k: v.detach().clone() for k, v in ppo.policy.named_parameters()}
+        for update in range(2):
+            with torch.inference_mode():
+                for step in range(32):
+                    actions = ppo.act(obs)
+                    self.assertEqual(actions.shape, (8, 28))
+                    obs = observations()
+                    dones = (torch.arange(8) + step + 1) % 7 == 0
+                    ppo.process_env_step(obs, torch.randn(8), dones,
+                                         {"time_outs": dones & (torch.arange(8) % 2 == 0)})
+                ppo.compute_returns(obs)
+            losses = ppo.update()
+            for value in losses.values():
+                if value is not None:
+                    self.assertTrue(torch.isfinite(torch.as_tensor(value)).all())
+        for name in ("memory_a.rnn.weight_ih_l0", "memory_c.rnn.weight_ih_l0", "actor.0.weight", "critic.0.weight"):
+            value = dict(ppo.policy.named_parameters())[name]
+            self.assertFalse(torch.equal(value, before[name]), name)
+            self.assertTrue(torch.isfinite(value.grad).all(), name)
+        self.assertEqual(int(next(iter(ppo.optimizer.state.values()))["step"]), 40)
+
+    def test_cli_flag_before_kit_and_play_checkpoint_requirement(self):
+        # Stop at AppLauncher construction, before Kit can be started.
+        class LaunchIntercept(Exception):
+            pass
+
+        class Launcher:
+            @staticmethod
+            def add_app_launcher_args(parser):
+                parser.add_argument("--device", default="cpu")
+
+            def __init__(self, args):
+                raise LaunchIntercept(args)
+
+        app = ModuleType("isaaclab.app")
+        app.AppLauncher = Launcher
+        for script, arguments in (
+            ("train_bulb_grasp_teacher.py", ["--max_iterations", "1", "--lstm"]),
+            ("play_bulb_grasp_teacher.py", ["--lstm", "--checkpoint", "lstm.pt"]),
+            ("play_bulb_grasp_teacher.py", []),
+        ):
+            with patch.dict(sys.modules, {"isaaclab.app": app}), patch.object(sys, "argv", [script, *arguments]), \
+                 patch.object(sys, "path", sys.path.copy()):
+                with self.assertRaises(LaunchIntercept) as caught:
+                    runpy.run_path(str(ROOT / "scripts/rsl_rl" / script), run_name="__main__")
+                self.assertEqual(caught.exception.args[0].lstm, "--lstm" in arguments)
+        with patch.dict(sys.modules, {"isaaclab.app": app}), \
+             patch.object(sys, "argv", ["play", "--lstm"]), patch.object(sys, "path", sys.path.copy()), \
+             contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as caught:
+                runpy.run_path(str(ROOT / "scripts/rsl_rl/play_bulb_grasp_teacher.py"), run_name="__main__")
+            self.assertEqual(caught.exception.code, 2)
+
+
+if __name__ == "__main__":
+    torch.set_num_threads(1)
+    unittest.main(verbosity=2)
